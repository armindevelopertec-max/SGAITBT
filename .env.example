# ============================================================
# SGA · Sistema de Gestión Académica — Variables de entorno
# Copia este archivo a '.env' y ajusta los valores:
#   cp .env.example .env
# NUNCA subas el archivo .env real (está en .gitignore).
# ============================================================

# ---------- Base de datos (PostgreSQL) ----------
DB_USER=sga_admin
DB_PASSWORD=cambia-esta-contrasena
DB_NAME=sga_itbt
# Puerto expuesto en el host (docker compose mapea POSTGRES a -p ${DB_PORT}:5432)
DB_PORT=5433

# ---------- MinIO (object storage) ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=cambia-esta-contrasena
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# ---------- pgAdmin ----------
PGADMIN_EMAIL=admin@sga-itbt.com
PGADMIN_PASSWORD=cambia-esta-contrasena
PGADMIN_PORT=5050

# ---------- Redis ----------
REDIS_PORT=6379

# ---------- Backend ----------
BACKEND_PORT=3001
NODE_ENV=development
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-unico
JWT_EXPIRATION=24h

# ---------- Frontend ----------
FRONTEND_PORT=3000